{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "/bin/herdr-tower hook codex --event permission-request",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python -m py_compile \"$FILEPATH\"",
            "type": "command"
          }
        ],
        "matcher": "Edit"
      },
      {
        "hooks": [
          {
            "command": "/bin/herdr-tower hook codex --event post-tool-use",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/bin/herdr-tower hook codex --event session-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/bin/herdr-tower hook codex --event stop",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/bin/herdr-tower hook codex --event user-prompt-submit",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
