{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "notify-me --hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "'/abs/herdr-tower' hook claude --event notification",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "my-logger",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "'/abs/herdr-tower' hook claude --event post-tool-use",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'/abs/herdr-tower' hook claude --event session-start",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'/abs/herdr-tower' hook claude --event stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'/abs/herdr-tower' hook claude --event user-prompt-submit",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(ls:*)"
    ]
  }
}
